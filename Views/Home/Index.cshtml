                                for (const action of actions.querySelectorAll("button")) action.disabled = false;
                            }
                        });
                        actions.append(button);
                    }
                    const updated = prop(row, "updatedAt");
                    if (updated) actions.append(el("span", "society-complaint-updated", `Updated ${dateLabel(updated)}`));
                    card.append(top, description, meta, remarksBlock, actions);
                } else {
                    remarksBlock.hidden = true;
                    card.append(top, description, meta);
                    if (currentRemarks) card.append(el("div", "society-complaint-final-note", `Admin note · ${currentRemarks}`));
                    const resolved = prop(row, "resolvedAt");
                    if (resolved) card.append(el("div", "society-complaint-final-date", `Resolved ${dateLabel(resolved)}`));
                }
                list.append(card);
            }
        };
        const refresh = async () => {
            reload.disabled = true;
