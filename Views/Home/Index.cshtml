                activeForm.form.reset();
                activeForm.cancel.hidden = true;
                activeForm.submit.textContent = "Create record";
                activeForm.card.querySelector("h3").textContent = `Create ${page.label || page.title}`;
                clearMessage(activeForm.message);
            }
        };

        const renderRows = () => {
            const statusAction = page.status ? row => {
                const group = el("div", "portal-action-row justify-content-end");
                if (page.status.transitions) {
                    const currentStatus = String(prop(row, page.status.property) || "").trim().toLowerCase();
                    const allowedTransitions = page.status.transitions[currentStatus] || [];
                    for (const transition of allowedTransitions) {
                        const button = el("button", `btn btn-sm ${transition.value === "Rejected" ? "btn-outline-danger" : "btn-outline-primary"}`, transition.label);
                        button.type = "button";
                        button.addEventListener("click", async () => {
                            const body = { status: transition.value };
                            if (page.key === "complaints") body.adminRemarks = prop(row, "adminRemarks") || "";
                            if (page.key === "complaints" && transition.value === "Rejected") {
                                const remarks = window.prompt("Admin remarks (optional):", body.adminRemarks);
                                if (remarks === null) return;
                                body.adminRemarks = remarks;
                            }
                            button.disabled = true;
                            try {
                                await api(`${page.endpoint}/${encodeURIComponent(idOf(row, page.key))}/status`, { method: "PATCH", body: JSON.stringify(body) });
                                await refresh();
                                showMessage(portalMessage, `${transition.label} completed.`, "success");
                            } catch (error) { showMessage(portalMessage, error.message, "danger"); }
                            finally { button.disabled = false; }
                        });
                        group.append(button);
                    }
                } else if (page.status.kind === "toggle") {
                    const currentValue = prop(row, page.status.property);
                    const active = currentValue === true || currentValue === 1 || String(currentValue).toLowerCase() === "true";
                    const button = el("button", `btn btn-sm ${active ? "btn-outline-danger" : "btn-outline-success"}`, active ? "Deactivate" : "Activate");
                    button.type = "button";
                    button.addEventListener("click", async () => {
                        try {
                            await api(`${page.endpoint}/${encodeURIComponent(idOf(row, page.key))}/status`, { method: "PATCH", body: JSON.stringify({ [page.status.property]: !active }) });
                            await refresh();
                        } catch (error) { showMessage(portalMessage, error.message, "danger"); }
                    });
                    group.append(button);
                } else {
                    return null;
                }
                return group;
            } : null;

            const actionBuilder = row => {
                const group = el("div", "portal-action-row justify-content-end");
                if (page.editFields && page.editFields.length) {
                    const edit = el("button", "btn btn-sm btn-outline-secondary", "Edit");
                    edit.type = "button";
                    edit.addEventListener("click", () => {
                        editingId = idOf(row, page.key);
                        activeForm.card.querySelector("h3").textContent = `Edit ${page.label || page.title}`;
                        activeForm.submit.textContent = "Save changes";
                        activeForm.cancel.hidden = false;
                        for (const [name, input] of activeForm.inputs) {
                            const value = prop(row, name);
                            if (input.type === "checkbox") input.checked = Boolean(value);
                            else input.value = value == null ? "" : String(value);
                        }
                        activeForm.card.scrollIntoView({ behavior: "smooth", block: "start" });
                    });
                    group.append(edit);
                }
                if (page.rowAction) {
                    const action = el("button", "btn btn-sm btn-outline-primary", page.rowAction.label);
                    action.type = "button";
                    action.addEventListener("click", async () => {
                        try {
                            const id = idOf(row, page.key);
                            await api(`${page.endpoint}/${encodeURIComponent(id)}${page.rowAction.suffix}`, { method: page.rowAction.method });
                            await refresh();
                        } catch (error) { showMessage(portalMessage, error.message, "danger"); }
                    });
                    group.append(action);
                }
                if (page.deleteRecord) {
                    const remove = el("button", "btn btn-sm btn-outline-danger", "Delete");
                    remove.type = "button";
                    remove.addEventListener("click", async () => {
                        if (!window.confirm("Delete this subscription plan? This action cannot be undone.")) return;
                        try {
                            await api(`${page.endpoint}/${encodeURIComponent(idOf(row, page.key))}`, { method: "DELETE" });
                            showMessage(portalMessage, "Subscription plan deleted.", "success");
                            await refresh();
                        } catch (error) { showMessage(portalMessage, error.message, "danger"); }
                    });
                    group.append(remove);
                }
                const status = statusAction && statusAction(row);
                if (status) group.append(...status.childNodes);
                return group.childNodes.length ? group : el("span", "portal-muted", "—");
            };

            const table = tableForRows(rows, page.columns, page.editFields || page.rowAction || page.status ? actionBuilder : null);
            const old = body.querySelector(".module-table");
            table.classList.add("module-table");
            if (old) old.replaceWith(table); else body.append(table);
        };

        const refresh = async () => {
            clearMessage(portalMessage);
            const result = await loadRows(page.endpoint, portalMessage);
            if (result !== null) rows = result;
            renderRows();
        };

        reload.addEventListener("click", refresh);

        if (page.createFields && page.createFields.length) {
            const allFormFields = [...page.createFields];
            for (const config of (page.editFields || [])) {
                if (!allFormFields.some(item => item.name === config.name)) allFormFields.push(config);
            }
            activeForm = buildForm(allFormFields, `Create ${page.label || page.title}`, async (values, controls) => {
                controls.submit.disabled = true;
                try {
                    const path = editingId !== null ? `${page.endpoint}/${encodeURIComponent(editingId)}` : page.endpoint;
                    const method = editingId !== null ? "PUT" : "POST";
                    const fields = editingId !== null ? (page.editFields || page.createFields) : page.createFields;
                    const body = {};
                    for (const config of fields) {
                        const value = values[config.name];
                        const normalizedValue = config.type === "number" && value !== "" ? Number(value)
                            : config.type === "time" && /^\d{2}:\d{2}$/.test(value) ? `${value}:00`
                            : value;
                        body[config.name] = normalizedValue;
                    }
                    await api(path, { method, body: JSON.stringify(body) });
                    showMessage(controls.message, editingId !== null ? "Changes saved." : "Record created.", "success");
                    resetForm();
                    await refresh();
                } catch (error) {
                    showMessage(controls.message, error.message, "danger");
                } finally {
                    controls.submit.disabled = false;
                }
            }, { submitText: "Create record", onCancel: resetForm });
            body.append(activeForm.card);
        }

        if (page.accountTools) {
            const toolsRow = el("div", "row g-3 mb-3");
            const accountForm = buildForm([field("residentId", "Resident profile ID", "number"), field("email", "Account email", "email"), field("password", "Temporary password", "password")], "Create resident account", async (values, controls) => {
                controls.submit.disabled = true;
                try {
                    await api(`${page.endpoint}/${encodeURIComponent(values.residentId)}/create-account`, { method: "POST", body: JSON.stringify({ email: values.email, password: values.password }) });
                    controls.form.reset();
                    showMessage(controls.message, "Account request completed.", "success");
                } catch (error) { showMessage(controls.message, error.message, "danger"); }
                finally { controls.submit.disabled = false; }
            }, { submitText: "Create account" });
            const linkForm = buildForm([field("residentId", "Resident profile ID", "number"), field("applicationUserId", "Application user ID")], "Link an existing account", async (values, controls) => {
                controls.submit.disabled = true;
                try {
                    await api(`${page.endpoint}/${encodeURIComponent(values.residentId)}/link-account`, { method: "PATCH", body: JSON.stringify({ applicationUserId: values.applicationUserId }) });
                    controls.form.reset();
                    showMessage(controls.message, "Account link request completed.", "success");
                    await refresh();
                } catch (error) { showMessage(controls.message, error.message, "danger"); }
                finally { controls.submit.disabled = false; }
            }, { submitText: "Link account" });
            const left = el("div", "col-12 col-xl-6");
            const right = el("div", "col-12 col-xl-6");
            accountForm.card.classList.remove("mb-3");
            linkForm.card.classList.remove("mb-3");
            left.append(accountForm.card); right.append(linkForm.card);
            toolsRow.append(left, right);
            body.append(toolsRow);
        }

        if (page.extraAction) {
            const action = el("button", "btn btn-sm btn-outline-primary mb-3", page.extraAction.label);
            action.type = "button";
            action.addEventListener("click", async () => {
                try { await api(page.extraAction.path, { method: page.extraAction.method }); await refresh(); showMessage(portalMessage, "Notifications updated.", "success"); }
                catch (error) { showMessage(portalMessage, error.message, "danger"); }
            });
            body.append(action);
        }

        refresh();
    }

    function renderSocietyAdmins(page) {
        const reload = pageShell(page, "Choose a society, then manage its administrator accounts using the documented scoped routes.");
        const scope = el("div", "portal-card p-3 mb-3");
        const scopeRow = el("div", "row g-2 align-items-end");
        const inputWrap = el("div", "col-12 col-md-5");
        const societyInput = el("input", "form-control");
        societyInput.type = "number";
        societyInput.required = true;
        societyInput.placeholder = "Society ID";
        const societyLabel = el("label", "portal-field-label", "Society ID");
        societyLabel.htmlFor = "superadmin-society-id";
        societyInput.id = "superadmin-society-id";
        inputWrap.append(societyLabel, societyInput);
        const loadWrap = el("div", "col-12 col-md-auto");
        const loadButton = el("button", "btn btn-outline-primary btn-sm", "Load administrators");
        loadButton.type = "button";
        loadWrap.append(loadButton);
        scopeRow.append(inputWrap, loadWrap);
        scope.append(scopeRow);
        portalWorkspace.append(scope);

        const formFields = [field("fullName", "Full name"), field("email", "Email address", "email"), field("password", "Temporary password", "password", false)];
        let selectedSocietyId = "";
        let editingUserId = null;
        let rows = [];
        let adminForm;
        const tableHost = el("div");

        const resetAdminForm = () => {
            editingUserId = null;
            if (!adminForm) return;
            adminForm.form.reset();
            adminForm.cancel.hidden = true;
            adminForm.submit.textContent = "Create administrator";
            adminForm.card.querySelector("h3").textContent = "Create society administrator";
            clearMessage(adminForm.message);
        };

        adminForm = buildForm(formFields, "Create society administrator", async (values, controls) => {
            if (!selectedSocietyId) {
                showMessage(controls.message, "Select a society first.", "warning");
                return;
            }
            if (!editingUserId && !values.password) {
                showMessage(controls.message, "Enter the initial password for this account.", "warning");
                return;
            }
            controls.submit.disabled = true;
            const base = `/api/superadmin/societies/${encodeURIComponent(selectedSocietyId)}/admins`;
            const body = editingUserId ? { fullName: values.fullName, email: values.email } : { fullName: values.fullName, email: values.email, password: values.password };
            try {
                await api(editingUserId ? `${base}/${encodeURIComponent(editingUserId)}` : base, { method: editingUserId ? "PUT" : "POST", body: JSON.stringify(body) });
                showMessage(controls.message, editingUserId ? "Administrator updated." : "Administrator created.", "success");
                resetAdminForm();
                await refresh();
            } catch (error) { showMessage(controls.message, error.message, "danger"); }
            finally { controls.submit.disabled = false; }
        }, { submitText: "Create administrator", onCancel: resetAdminForm });
        adminForm.card.classList.add("mb-3");
        portalWorkspace.append(adminForm.card, tableHost);

        const renderTable = () => {
            const table = tableForRows(rows, [["fullName", "Name"], ["email", "Email"], ["isActive", "Status"]], row => {
                const actions = el("div", "portal-action-row justify-content-end");
                const edit = el("button", "btn btn-sm btn-outline-secondary", "Edit");
                edit.type = "button";
                edit.addEventListener("click", () => {
                    editingUserId = idOf(row, "admins");
                    adminForm.card.querySelector("h3").textContent = "Edit society administrator";
                    adminForm.submit.textContent = "Save changes";
                    adminForm.cancel.hidden = false;
                    adminForm.inputs.get("fullName").value = prop(row, "fullName") || "";
                    adminForm.inputs.get("email").value = prop(row, "email") || "";
                    adminForm.inputs.get("password").value = "";
                    adminForm.card.scrollIntoView({ behavior: "smooth", block: "start" });
                });
                actions.append(edit);
                const activeValue = prop(row, "isActive");
                const active = activeValue === true || activeValue === 1 || String(activeValue).toLowerCase() === "true";
                const status = el("button", `btn btn-sm ${active ? "btn-outline-danger" : "btn-outline-success"}`, active ? "Deactivate" : "Activate");
                status.type = "button";
                status.addEventListener("click", async () => {
                    try {
                        await api(`/api/superadmin/societies/${encodeURIComponent(selectedSocietyId)}/admins/${encodeURIComponent(idOf(row, "admins"))}/status`, { method: "PATCH", body: JSON.stringify({ isActive: !active }) });
                        await refresh();
                    } catch (error) { showMessage(portalMessage, error.message, "danger"); }
                });
                actions.append(status);
                return actions;
            });
            tableHost.replaceChildren(table);
        };

        const refresh = async () => {
            const value = societyInput.value.trim();
            if (!value) {
                showMessage(portalMessage, "Enter a society ID to load administrators.", "warning");
                return;
            }
            selectedSocietyId = value;
            clearMessage(portalMessage);
            rows = [];
            renderTable();
            const result = await loadRows(`/api/superadmin/societies/${encodeURIComponent(value)}/admins`, portalMessage);
            if (result !== null) rows = result;
            renderTable();
        };
        loadButton.addEventListener("click", refresh);
        reload.addEventListener("click", refresh);
    }

    function renderSubscriptions(page) {
        const reload = pageShell(page, "Assign or update a society plan, review the current subscription, and change its status.");
        const scopeCard = el("div", "portal-card p-3 mb-3");
        const scopeRow = el("div", "row g-2 align-items-end");
        const societyField = makeFieldInput(field("societyId", "Society ID", "number"));
        societyField.wrapper.classList.add("col-12", "col-md-5");
        const loadWrap = el("div", "col-12 col-md-auto");
        const loadButton = el("button", "btn btn-outline-primary btn-sm", "Load subscription");
        loadButton.type = "button";
        loadWrap.append(loadButton);
        scopeRow.append(societyField.wrapper, loadWrap);
        scopeCard.append(scopeRow);
        portalWorkspace.append(scopeCard);

        let societyId = "";
        let current = null;
        const subscriptionFields = [field("subscriptionPlanId", "Subscription plan ID", "number"), field("startDate", "Start date", "datetime-local"), field("endDate", "End date", "datetime-local")];
        const form = buildForm(subscriptionFields, "Assign a subscription", async (values, controls) => {
            if (!societyId) {
                showMessage(controls.message, "Load a society first.", "warning");
                return;
            }
            controls.submit.disabled = true;
            const body = { subscriptionPlanId: Number(values.subscriptionPlanId), startDate: values.startDate, endDate: values.endDate };
            try {
                await api(`/api/superadmin/societies/${encodeURIComponent(societyId)}/subscription`, { method: current ? "PUT" : "POST", body: JSON.stringify(body) });
                showMessage(controls.message, current ? "Subscription updated." : "Subscription assigned.", "success");
                await refresh();
            } catch (error) { showMessage(controls.message, error.message, "danger"); }
            finally { controls.submit.disabled = false; }
        }, { submitText: "Assign subscription" });
        portalWorkspace.append(form.card);

        const statusForm = buildForm([field("status", "Subscription status"), field("isActive", "Active", "checkbox", false)], "Update subscription status", async (values, controls) => {
            if (!societyId) {
                showMessage(controls.message, "Load a society first.", "warning");
                return;
            }
            controls.submit.disabled = true;
            try {
                await api(`/api/superadmin/societies/${encodeURIComponent(societyId)}/subscription/status`, { method: "PATCH", body: JSON.stringify({ status: values.status, isActive: values.isActive }) });
                showMessage(controls.message, "Subscription status updated.", "success");
                await refresh();
            } catch (error) { showMessage(controls.message, error.message, "danger"); }
            finally { controls.submit.disabled = false; }
        }, { submitText: "Save status" });
        portalWorkspace.append(statusForm.card);
        const currentHost = el("div");
        portalWorkspace.append(currentHost);

        const refresh = async () => {
            const value = societyField.input.value.trim();
            if (!value) {
                societyId = "";
                current = null;
                form.card.querySelector("h3").textContent = "Assign a subscription";
                form.submit.textContent = "Assign subscription";
                statusForm.card.hidden = true;
                currentHost.replaceChildren();
                showMessage(portalMessage, "Enter a society ID to load its subscription.", "warning");
                return;
            }
            societyId = value;
            clearMessage(portalMessage);
            try {
                const payload = await api(`/api/superadmin/societies/${encodeURIComponent(value)}/subscription`);
                const data = dataOf(payload);
                const found = Array.isArray(data) ? data : data && typeof data === "object" ? [data] : [];
                current = found[0] || null;
                statusForm.card.hidden = !current;
                form.card.querySelector("h3").textContent = current ? "Update subscription" : "Assign a subscription";
                form.submit.textContent = current ? "Save subscription" : "Assign subscription";
                if (current) {
                    for (const config of subscriptionFields) {
                        const input = form.inputs.get(config.name);
                        let fieldValue = prop(current, config.name);
                        if (fieldValue && config.type === "datetime-local") fieldValue = String(fieldValue).slice(0, 16);
                        input.value = fieldValue == null ? "" : String(fieldValue);
                    }
                    statusForm.inputs.get("status").value = prop(current, "status") || "";
                    const activeValue = prop(current, "isActive");
                    statusForm.inputs.get("isActive").checked = activeValue === true || activeValue === 1 || String(activeValue).toLowerCase() === "true";
                    currentHost.replaceChildren(tableForRows([current], [["subscriptionPlanId", "Plan"], ["startDate", "Starts"], ["endDate", "Ends"], ["status", "Status"], ["isActive", "Active"]]));
                } else {
                    form.form.reset();
                    currentHost.replaceChildren(el("div", "portal-card portal-empty", "No subscription was returned for this society yet."));
                }
            } catch (error) {
                current = null;
                statusForm.card.hidden = true;
                form.card.querySelector("h3").textContent = "Assign a subscription";
                form.submit.textContent = "Assign subscription";
                form.form.reset();
                currentHost.replaceChildren(el("div", "portal-card portal-empty", "No current subscription was found. You can assign one if this society is valid."));
                showMessage(portalMessage, error.message, "warning");
            }
        };
        loadButton.addEventListener("click", refresh);
        reload.addEventListener("click", refresh);
        statusForm.card.hidden = true;
    }

    function renderAccess(page) {
        const reload = pageShell(page, "Open a PIN screen for any active amenity, then review issued PIN records and entry attempts.");
        const workspace = el("div", "society-access-page");
        const summary = el("div", "society-access-summary");
        const activeAmenityMetric = makeMetric("—", "Active amenity screens", "society-access-metric");
        const activePinMetric = makeMetric("—", "Active PINs", "society-access-metric");
        const successfulMetric = makeMetric("—", "Successful entries", "society-access-metric");
        summary.append(activeAmenityMetric, activePinMetric, successfulMetric);
        const navigation = el("div", "society-access-navigation");
        const content = el("div", "society-access-content");
        workspace.append(summary, navigation, content);
        portalWorkspace.append(workspace);

        let amenities = [];
        let pins = [];
        let logs = [];
        let selectedAmenityId = null;
        let activeSection = "screens";

        function makeMetric(value, label, className) {
            const card = el("div", `portal-card ${className}`);
            card.append(el("div", "society-access-metric-value", value), el("div", "society-access-metric-label", label));
            return card;
        }
        function activeAmenities() {
            return amenities.filter(item => prop(item, "isActive") === true || String(prop(item, "isActive")).toLowerCase() === "true");
        }
        function updateMetrics() {
            activeAmenityMetric.querySelector(".society-access-metric-value").textContent = String(activeAmenities().length);
            activePinMetric.querySelector(".society-access-metric-value").textContent = String(pins.filter(pin => String(prop(pin, "status") || "").toLowerCase() === "active").length);
            successfulMetric.querySelector(".society-access-metric-value").textContent = String(logs.filter(log => prop(log, "isSuccessful") === true || String(prop(log, "isSuccessful")).toLowerCase() === "true").length);
        }
        function renderNavigation() {
            navigation.replaceChildren();
            for (const [key, label] of [["screens", "Amenity entry screens"], ["pins", "Issued PINs"], ["logs", "Access logs"]]) {
                const button = el("button", `btn btn-sm ${activeSection === key ? "btn-primary" : "btn-outline-secondary"}`, label);
                button.type = "button";
                button.addEventListener("click", () => {
                    activeSection = key;
                    renderNavigation();
                    renderSection();
                });
                navigation.append(button);
            }
        }
        function renderEntryScreens() {
            const active = activeAmenities();
            const section = el("div", "society-access-screen-layout");
            const chooser = el("nav", "society-access-amenity-list");
            chooser.setAttribute("aria-label", "Amenity entry screens");
            const screenHost = el("div", "society-access-screen-host");
            section.append(chooser, screenHost);
            if (!active.length) {
                screenHost.append(el("div", "portal-card society-access-empty", "No active amenities yet. Add an amenity to create its PIN entry screen here."));
                content.replaceChildren(section);
                return;
            }
            if (!active.some(item => String(idOf(item, "amenities")) === String(selectedAmenityId))) selectedAmenityId = String(idOf(active[0], "amenities"));
            for (const amenity of active) {
                const amenityId = String(idOf(amenity, "amenities"));
                const button = el("button", `society-access-amenity-option ${amenityId === selectedAmenityId ? "active" : ""}`);
                button.type = "button";
                button.append(el("span", "society-access-amenity-option-name", prop(amenity, "name") || `Amenity ${amenityId}`));
                button.append(el("span", "society-access-amenity-option-caption", "Open entry screen"));
                button.addEventListener("click", () => {
                    selectedAmenityId = amenityId;
                    renderEntryScreens();
                });
                chooser.append(button);
            }
            const amenity = active.find(item => String(idOf(item, "amenities")) === String(selectedAmenityId));
            const screen = el("section", "portal-card society-access-entry-screen");
            const screenTop = el("div", "society-access-entry-top");
            screenTop.append(el("div", "society-access-live-mark", "LIVE ENTRY SCREEN"));
            const amenityName = prop(amenity, "name") || "Amenity";
            screenTop.append(el("div", "society-access-entry-amenity", amenityName));
            screenTop.append(el("div", "society-access-entry-hours", `Hours · ${displayValue(prop(amenity, "openingTime"))} – ${displayValue(prop(amenity, "closingTime"))}`));
            const instruction = el("p", "society-access-entry-instruction", "Enter the resident’s six-digit PIN. The system checks it automatically when the final digit is entered.");
            const pinLabel = el("label", "portal-field-label society-access-pin-label", "Resident PIN");
            const pinInput = el("input", "form-control society-access-pin-input");
            pinInput.type = "text";
            pinInput.inputMode = "numeric";
            pinInput.autocomplete = "off";
            pinInput.maxLength = 6;
            pinInput.pattern = "[0-9]{6}";
            pinInput.placeholder = "• • • • • •";
            pinInput.setAttribute("aria-label", `Six-digit PIN for ${amenityName}`);
            pinLabel.htmlFor = `amenity-pin-${selectedAmenityId}`;
            pinInput.id = pinLabel.htmlFor;
            const feedback = el("div", "society-access-validation-result");
            feedback.hidden = true;
            const screenNote = el("div", "society-access-entry-note", "This screen checks the PIN against this amenity only. A successful check is recorded in Access logs.");
            screen.append(screenTop, instruction, pinLabel, pinInput, feedback, screenNote);
            pinInput.addEventListener("input", async () => {
                pinInput.value = pinInput.value.replace(/[^0-9]/g, "").slice(0, 6);
                feedback.hidden = true;
                if (pinInput.value.length !== 6 || pinInput.disabled) return;
                const pin = pinInput.value;
                pinInput.disabled = true;
                feedback.hidden = false;
                feedback.className = "society-access-validation-result is-checking";
                feedback.textContent = "Checking PIN…";
                try {
                    const response = await api("/api/societyadmin/amenity-pins/validate", {
                        method: "POST",
                        body: JSON.stringify({ amenityId: Number(selectedAmenityId), pin })
                    });
                    const data = dataOf(response);
                    const accepted = prop(data, "isSuccessful") === true || String(prop(data, "isSuccessful")).toLowerCase() === "true";
                    feedback.className = `society-access-validation-result ${accepted ? "is-accepted" : "is-rejected"}`;
                    feedback.textContent = prop(data, "message") || (accepted ? "PIN accepted. Entry allowed." : "PIN not accepted.");
                } catch (error) {
                    feedback.className = "society-access-validation-result is-rejected";
                    feedback.textContent = error.message || "The PIN could not be checked. Try again.";
                } finally {
                    pinInput.value = "";
                    pinInput.disabled = false;
                    await refreshCollections(false);
                    pinInput.focus();
                }
            });
            screenHost.append(screen);
            content.replaceChildren(section);
        }
        function renderCollections(kind) {
            const host = el("div", "society-access-records");
            const searchWrap = el("label", "society-access-record-search");
            const search = el("input", "form-control");
            search.type = "search";
            search.placeholder = kind === "pins" ? "Search PIN records" : "Search access logs";
            search.setAttribute("aria-label", search.placeholder);
            searchWrap.append(search);
            const tableHost = el("div");
            const rows = kind === "pins" ? pins : logs;
            const columns = kind === "pins"
                ? [["amenityName", "Amenity"], ["status", "PIN status"], ["generatedAt", "Generated"], ["expiresAt", "Expires"], ["usedAt", "Used"]]
                : [["amenityName", "Amenity"], ["flatId", "Flat"], ["residentProfileId", "Resident profile"], ["isSuccessful", "Result"], ["attemptedAt", "Attempted"], ["failureReason", "Reason"]];
            const draw = () => {
                const query = search.value.trim().toLowerCase();
                const visible = rows.filter(row => columns.some(([key]) => String(displayValue(prop(row, key))).toLowerCase().includes(query)));
                const table = tableForRows(visible, columns);
                table.classList.add("society-access-table");
                const empty = table.querySelector(".portal-empty");
                if (empty && rows.length && query) empty.textContent = "No records match your search.";
                tableHost.replaceChildren(table);
            };
            search.addEventListener("input", draw);
            draw();
            host.append(searchWrap, tableHost);
            content.replaceChildren(host);
        }
        function renderSection() {
            if (activeSection === "screens") renderEntryScreens();
            else renderCollections(activeSection);
        }
        async function refreshCollections(redraw = true) {
            try {
                const [amenityPayload, pinPayload, logPayload] = await Promise.all([
                    api("/api/societyadmin/amenities"),
                    api("/api/societyadmin/amenity-pins"),
                    api("/api/societyadmin/amenity-access-logs")
                ]);
                amenities = rowsOf(amenityPayload);
                pins = rowsOf(pinPayload);
                logs = rowsOf(logPayload);
                updateMetrics();
                if (redraw || activeSection !== "screens") renderSection();
                clearMessage(portalMessage);
            } catch (error) {
                showMessage(portalMessage, error.message || "Could not load amenities, PINs, and access logs from the live API.", "danger");
            }
        }
        reload.addEventListener("click", () => refreshCollections(true));
        renderNavigation();
        renderSection();
        refreshCollections(true);
    }

    function renderReports(page) {
        const reload = pageShell(page, "Choose a live report to review society activity and service records.");
        const workspace = el("div", "society-reports-page");
        const picker = el("div", "society-reports-picker");
        const pickerHeading = el("div", "society-reports-picker-heading");
        pickerHeading.append(el("h3", "portal-section-title mb-1", "Available reports"), el("p", "portal-muted small mb-0", "Select a report to load the latest records from the API."));
        const reportButtons = el("div", "society-reports-options");
        const summary = el("div", "society-reports-summary");
        const count = el("div", "society-reports-count", "—");
        const countLabel = el("div", "society-reports-count-label", "Records");
        const selectedLabel = el("div", "society-reports-selected-label", "Choose a report");
        summary.append(count, countLabel, selectedLabel);
        const resultCard = el("div", "portal-card society-reports-results");
        const resultHeader = el("div", "society-reports-result-header");
        const resultTitle = el("h3", "portal-section-title mb-0", "Report results");
        const search = el("input", "form-control society-reports-search");
        search.type = "search";
        search.placeholder = "Search loaded results";
        search.setAttribute("aria-label", "Search loaded report results");
        search.hidden = true;
        resultHeader.append(resultTitle, search);
        const resultHost = el("div", "society-reports-result-host");
        resultHost.append(el("div", "society-reports-empty", "Choose one of the reports above to load its live data."));
        resultCard.append(resultHeader, resultHost);
        picker.append(pickerHeading, reportButtons);
        workspace.append(picker, summary, resultCard);
        portalWorkspace.append(workspace);
        const columnsByPath = {
            "/api/societyadmin/reports/residents": [["residentProfileId", "Resident ID"], ["fullName", "Resident"], ["mobileNumber", "Mobile"], ["flatId", "Flat ID"], ["isHome", "Home"], ["isActive", "Active"], ["createdAt", "Created"]],
            "/api/societyadmin/reports/guest-entries": [["guestEntryRequestId", "Entry ID"], ["guestName", "Guest"], ["guestPhone", "Phone"], ["flatId", "Flat ID"], ["purpose", "Purpose"], ["status", "Status"], ["createdAt", "Requested"]],
            "/api/societyadmin/reports/parcels": [["parcelId", "Parcel ID"], ["courierName", "Courier"], ["trackingNumber", "Tracking number"], ["flatId", "Flat ID"], ["status", "Status"], ["receivedAt", "Received"], ["collectedAt", "Collected"]],
            "/api/societyadmin/reports/complaints": [["complaintId", "Case ID"], ["subject", "Subject"], ["status", "Status"], ["flatId", "Flat ID"], ["adminRemarks", "Admin note"], ["createdAt", "Filed"], ["resolvedAt", "Resolved"]],
            "/api/societyadmin/reports/amenity-access": [["amenityAccessLogId", "Log ID"], ["amenityName", "Amenity"], ["flatId", "Flat ID"], ["residentProfileId", "Resident ID"], ["isSuccessful", "Success"], ["attemptedAt", "Attempted"], ["failureReason", "Reason"]]
        };
        let selectedReport = null;
        let loadedRows = [];
        let loading = false;
        let reportError = null;
        function drawResults() {
            const columns = selectedReport ? columnsByPath[selectedReport.path] : [];
            const query = search.value.trim().toLowerCase();
            const visible = loadedRows.filter(row => columns.some(([key]) => String(displayValue(prop(row, key))).toLowerCase().includes(query)));
            count.textContent = String(loadedRows.length);
            selectedLabel.textContent = selectedReport ? selectedReport.label : "Choose a report";
            if (loading) {
                resultHost.replaceChildren(el("div", "society-reports-empty", `Loading ${selectedReport.label.toLowerCase()}…`));
                return;
            }
            if (!selectedReport) {
                resultHost.replaceChildren(el("div", "society-reports-empty", "Choose one of the reports above to load its live data."));
                search.hidden = true;
                return;
            }
            search.hidden = false;
            if (reportError) {
                resultHost.replaceChildren(el("div", "society-reports-empty", reportError));
                return;
            }
            if (!loadedRows.length) {
                resultHost.replaceChildren(el("div", "society-reports-empty", "The API returned no records for this report."));
                return;
            }
            const table = tableForRows(visible, columns);
            table.classList.add("society-reports-table");
            const empty = table.querySelector(".portal-empty");
            if (empty && query) empty.textContent = "No report records match your search.";
            resultHost.replaceChildren(table);
        }
        async function loadReport(report) {
            selectedReport = report;
            loadedRows = [];
            reportError = null;
            loading = true;
            search.value = "";
            reportButtons.querySelectorAll("button").forEach(button => button.classList.toggle("active", button.dataset.reportPath === report.path));
            clearMessage(portalMessage);
            drawResults();
            try {
                loadedRows = reportRowsOf(await api(report.path));
            } catch (error) {
                reportError = error.message || `Could not load the ${report.label.toLowerCase()} report.`;
                showMessage(portalMessage, reportError, "danger");
            } finally {
                loading = false;
                drawResults();
            }
        }
        for (const report of reports) {
            const button = el("button", "society-report-option", report.label);
            button.type = "button";
            button.dataset.reportPath = report.path;
            button.append(el("span", "society-report-option-arrow", "›"));
            button.addEventListener("click", () => loadReport(report));
            reportButtons.append(button);
        }
        search.addEventListener("input", drawResults);
        reload.addEventListener("click", () => selectedReport ? loadReport(selectedReport) : showMessage(portalMessage, "Choose a report first.", "info"));
    }

    function renderServiceLimits(page) {
        setHeading(page.title, "The supplied API contract does not include resident-facing routes for these actions yet.");
        const card = el("div", "portal-card p-4");
        card.append(el("h3", "portal-section-title mb-3", "Available resident API workflows"));
        card.append(el("p", "small portal-muted", "This workspace currently supports resident complaints, notifications, and amenity PINs."));
        card.append(el("h3", "portal-section-title mt-4 mb-3", "Awaiting documented resident endpoints"));
        const list = el("ul", "small portal-muted mb-0");
        ["Home or away status", "Guest approvals", "Parcel tracking", "Amenity access history"].forEach(item => list.append(el("li", "mb-2", item)));
        card.append(list);
        portalWorkspace.append(card);
    }

    document.getElementById("portal-user-chip").hidden = true;

})();
</script>
}
