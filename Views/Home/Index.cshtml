            const flatNames = new Map(flats.map(flat => [String(idOf(flat, "flats")), prop(flat, "flatNumber") || `Flat ${idOf(flat, "flats")}`]));
            const counts = { open: 0, inprogress: 0, resolved: 0, rejected: 0 };
            for (const row of rows) {
                const key = String(prop(row, "status") || "").trim().toLowerCase();
                if (Object.prototype.hasOwnProperty.call(counts, key)) counts[key]++;
            }
            totalCount.textContent = String(rows.length);
            statusSummary.textContent = `${counts.open} open · ${counts.inprogress} in progress · ${counts.resolved} resolved · ${counts.rejected} rejected`;
