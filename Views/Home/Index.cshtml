            const collectedCount = rows.filter(row => statusOf(row) === "collected").length;
            totalCount.textContent = String(rows.length);
            statusSummary.textContent = `${receivedCount} awaiting collection · ${collectedCount} collected`;
            const table = tableForRows(visible, [["parcelId", "Parcel ID"], ["courierName", "Courier"], ["trackingNumber", "Tracking number"], ["residentName", "Resident"], ["flatLabel", "Flat"], ["receivedLabel", "Received"], ["collectedLabel", "Collected"], ["statusLabel", "Status"]], row => {
                const actions = el("div", "portal-action-row justify-content-end society-parcels-row-actions");
                if (String(prop(row, "status") || "").trim().toLowerCase() === "received") {
                    const button = el("button", "btn btn-sm btn-outline-primary", "Mark collected");
                    button.type = "button";
                    button.addEventListener("click", async () => {
                        button.disabled = true;
                        try {
                            await api(`${page.endpoint}/${encodeURIComponent(idOf(row, "parcels"))}/status`, { method: "PATCH", body: JSON.stringify({ status: "Collected" }) });
                            await refresh();
                            showMessage(portalMessage, "Parcel marked as collected.", "success");
                        } catch (error) {
                            showMessage(portalMessage, error.message, "danger");
                        } finally {
                            button.disabled = false;
                        }
                    });
                    actions.append(button);
