                    ...row,
                    residentName: residentNames.get(String(prop(row, "residentProfileId"))) || `Resident ${prop(row, "residentProfileId") ?? "—"}`,
                    flatLabel: flatNames.get(String(prop(row, "flatId"))) || `Flat ${prop(row, "flatId") ?? "—"}`,
                    statusLabel: prop(row, "status") || "—",
                    receivedLabel: receivedDate && !Number.isNaN(receivedDate.getTime()) ? new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(receivedDate) : "—",
                    collectedLabel: collectedDate && !Number.isNaN(collectedDate.getTime()) ? new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(collectedDate) : "—"
                };
            }).filter(row => `${prop(row, "courierName") || ""} ${prop(row, "trackingNumber") || ""} ${row.residentName} ${row.flatLabel}`.toLowerCase().includes(query));
            const statusOf = row => String(prop(row, "status") || "").trim().toLowerCase();
