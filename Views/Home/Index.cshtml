                remarksBlock.append(remarksLabel, remarks);
                const actions = el("div", "society-complaint-actions");
                const transitions = transitionsFor(prop(row, "status"));
                if (transitions.length) {
                    for (const [nextStatus, label, danger] of transitions) {
                        const button = el("button", `btn btn-sm ${danger ? "btn-outline-danger" : "btn-primary"}`, label);
                        button.type = "button";
                        button.addEventListener("click", async () => {
                            for (const action of actions.querySelectorAll("button")) action.disabled = true;
                            try {
                                await api(`${page.endpoint}/${encodeURIComponent(idOf(row, "complaints"))}/status`, {
                                    method: "PATCH",
