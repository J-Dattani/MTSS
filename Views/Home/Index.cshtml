        };
        const renderRows = () => {
            const query = search.value.trim().toLowerCase();
            const visible = rows.filter(row => `${prop(row, "name") || ""} ${idOf(row, "wings") || ""}`.toLowerCase().includes(query));
            const active = rows.filter(isActive).length;
            count.textContent = String(rows.length);
            activeCount.textContent = `${active} active · ${rows.length - active} inactive`;
            const table = tableForRows(visible, [["wingId", "Wing ID"], ["name", "Wing name"], ["statusLabel", "Status"], ["createdLabel", "Created"]], row => {
                const actions = el("div", "portal-action-row justify-content-end society-wings-row-actions");
                const edit = el("button", "btn btn-sm btn-outline-secondary", "Edit");
                edit.type = "button";
                edit.addEventListener("click", () => {
                    editingId = idOf(row, "wings");
                    editor.card.querySelector("h3").textContent = "Edit wing";
                    editor.submit.textContent = "Save changes";
                    editor.cancel.hidden = false;
                    editor.inputs.get("name").value = prop(row, "name") || "";
                    clearMessage(editor.message);
                    editor.card.hidden = false;
                    editor.card.scrollIntoView({ behavior: "smooth", block: "nearest" });
                    editor.inputs.get("name").focus({ preventScroll: true });
                });
                const activeNow = isActive(row);
                const status = el("button", `btn btn-sm ${activeNow ? "btn-outline-danger" : "btn-outline-success"}`, activeNow ? "Deactivate" : "Activate");
                status.type = "button";
