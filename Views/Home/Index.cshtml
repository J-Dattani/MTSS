                }
                return actions;
            });
            table.classList.add("society-parcels-table");
            const emptyCell = table.querySelector(".portal-empty");
            if (emptyCell && rows.length && query) emptyCell.textContent = "No parcels match your search.";
            tableHost.replaceChildren(table);
        };
        const refresh = async () => {
            reload.disabled = true;
            try {
                const [parcelPayload, residentPayload, flatPayload] = await Promise.all([
                    api(page.endpoint),
                    api("/api/societyadmin/residents"),
                    api("/api/societyadmin/flats")
                ]);
                rows = rowsOf(parcelPayload);
                residents = rowsOf(residentPayload);
                flats = rowsOf(flatPayload);
                updateResidentOptions();
                addButton.disabled = !residents.some(isActive);
                addButton.title = addButton.disabled ? "Add or activate a resident before logging a parcel." : "Log a parcel";
                renderRows();
