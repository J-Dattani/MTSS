                top.append(heading, status);
                const description = el("p", "society-complaint-description", prop(row, "description") || "No description provided.");
                const residentName = residentNames.get(String(prop(row, "residentProfileId"))) || `Resident ${prop(row, "residentProfileId") ?? "—"}`;
                const flatLabel = flatNames.get(String(prop(row, "flatId"))) || `Flat ${prop(row, "flatId") ?? "—"}`;
                const meta = el("div", "society-complaint-meta");
                meta.append(el("span", "society-complaint-meta-item", `Resident · ${residentName}`), el("span", "society-complaint-meta-item", flatLabel));
