                const normalizedStatus = String(prop(row, "status") || "").trim().toLowerCase();
                const residentName = residentNames.get(String(prop(row, "residentProfileId"))) || `Resident ${prop(row, "residentProfileId") ?? "—"}`;
                const flatLabel = flatNames.get(String(prop(row, "flatId"))) || `Flat ${prop(row, "flatId") ?? "—"}`;
                const matchesStatus = !statusFilter || normalizedStatus === statusFilter;
                const haystack = `${prop(row, "subject") || ""} ${prop(row, "description") || ""} ${residentName} ${flatLabel} ${prop(row, "adminRemarks") || ""}`.toLowerCase();
