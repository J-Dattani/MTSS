        body.societyadmin-mode #portal-workspace .society-dashboard-shortcut { display: flex; align-items: center; gap: 12px; min-height: 64px; padding: 11px 13px; border: 1px solid #e7ecf4; border-radius: 13px; background: #fff; color: #273751; text-align: left; transition: border-color .16s ease, background .16s ease, transform .16s ease; }
