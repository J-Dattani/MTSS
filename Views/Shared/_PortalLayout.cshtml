<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MTSS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root { color-scheme: light; --portal-ink: #17243b; --portal-muted: #718096; --portal-line: #e6ebf2; --portal-bg: #f4f7fb; --portal-blue: #3559d8; }
        body { margin: 0; background: var(--portal-bg); color: var(--portal-ink); font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; }
        .portal-frame { min-height: 100vh; display: grid; grid-template-columns: 252px minmax(0, 1fr); }
        .portal-sidebar { background: #101b31; color: #dce5f5; padding: 24px 16px; display: flex; flex-direction: column; gap: 24px; }
        .portal-brand { display: flex; align-items: center; gap: 12px; padding: 0 10px; }
        .portal-brand-mark { width: 40px; height: 40px; border-radius: 14px; display: grid; place-items: center; background: #4868e6; color: white; font-weight: 800; font-size: 20px; }
        .portal-brand-title { color: #fff; font-size: 18px; font-weight: 750; letter-spacing: .02em; }
        .portal-brand-subtitle { color: #98a8c3; font-size: 11px; }
        .portal-nav-label { margin: 8px 10px 4px; color: #7f91b0; font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
        .portal-nav { display: grid; gap: 5px; }
        .portal-nav button { width: 100%; border: 0; border-radius: 10px; padding: 10px 12px; background: transparent; color: #c7d3e8; text-align: left; font-size: 13px; font-weight: 600; }
        .portal-nav button:hover, .portal-nav button.active { background: #223252; color: white; }
        .portal-nav button.active { box-shadow: inset 3px 0 #7891ff; }
        .portal-sidebar-note { margin-top: auto; border: 1px solid #2a3b5d; border-radius: 13px; padding: 13px; color: #aebbd0; font-size: 11px; line-height: 1.5; }
        .portal-main { min-width: 0; display: flex; flex-direction: column; }
        .portal-topbar { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 14px clamp(18px, 4vw, 42px); background: #fff; border-bottom: 1px solid var(--portal-line); }
        .portal-topbar-kicker { color: var(--portal-muted); font-size: 10px; font-weight: 800; letter-spacing: .15em; }
        .portal-topbar-title { margin: 2px 0 0; font-size: 18px; font-weight: 750; }
        .portal-user-chip { display: flex; align-items: center; gap: 10px; color: var(--portal-muted); font-size: 12px; }
        .portal-user-avatar { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: #e8edff; color: var(--portal-blue); font-weight: 800; }
        .portal-main-content { width: 100%; max-width: 1480px; margin: 0 auto; padding: clamp(18px, 4vw, 42px); flex: 1; }
        .portal-footer { padding: 16px clamp(18px, 4vw, 42px); display: flex; justify-content: space-between; gap: 12px; color: #8793a5; font-size: 11px; }
        .portal-card { background: #fff; border: 1px solid var(--portal-line); border-radius: 16px; box-shadow: 0 7px 24px rgba(30, 51, 86, .035); }
        .portal-page-title { margin: 4px 0 8px; font-size: clamp(24px, 3vw, 32px); font-weight: 780; letter-spacing: -.035em; }
        .portal-page-subtitle { max-width: 720px; margin: 0; color: var(--portal-muted); font-size: 14px; line-height: 1.6; }
        .portal-eyebrow { color: var(--portal-blue); font-size: 10px; font-weight: 850; letter-spacing: .16em; text-transform: uppercase; }
        .portal-stat-value { font-size: 28px; font-weight: 800; letter-spacing: -.04em; }
        .portal-stat-label { color: var(--portal-muted); font-size: 12px; font-weight: 650; }
        .portal-section-title { margin: 0; font-size: 15px; font-weight: 750; }
        .portal-section-note { margin: 5px 0 0; color: var(--portal-muted); font-size: 12px; }
        .portal-table th { color: #718096; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
        .portal-table td { color: #26344b; font-size: 12px; vertical-align: middle; }
        .portal-empty { padding: 34px 14px; color: var(--portal-muted); text-align: center; font-size: 13px; }
        .portal-field-label { display: block; margin-bottom: 5px; color: #48566c; font-size: 11px; font-weight: 700; }
        .portal-form-field { min-width: 0; }
        .portal-alert { border-radius: 12px; padding: 11px 14px; font-size: 12px; }
        .portal-action-row { display: flex; flex-wrap: wrap; gap: 6px; }
        .portal-muted { color: var(--portal-muted); }
        .portal-login-wrap { max-width: 980px; margin: 5vh auto; }
        .portal-login-card { overflow: hidden; }
        .portal-login-aside { min-height: 100%; padding: 36px; color: white; background: linear-gradient(145deg, #142544, #2e4a9d); }
        .portal-login-aside p { color: #cad5f0; font-size: 13px; line-height: 1.65; }
        body.societyadmin-mode {
            --portal-blue: #3657d9;
            --portal-bg: #f3f6fc;
            --portal-line: #e4eaf4;
        }
        body.societyadmin-mode .portal-frame {
            background: radial-gradient(circle at 85% 5%, rgba(108, 135, 255, .09), transparent 24rem), var(--portal-bg);
        }
        body.societyadmin-mode .portal-sidebar {
            background: linear-gradient(165deg, #0f1b33 0%, #16294c 62%, #1b3561 100%);
            box-shadow: 12px 0 34px rgba(20, 36, 67, .08);
        }
        body.societyadmin-mode .portal-brand-mark {
            border-radius: 13px;
            background: linear-gradient(145deg, #5a77f0, #3557d8);
            box-shadow: 0 8px 18px rgba(71, 101, 224, .3);
        }
        body.societyadmin-mode .portal-nav button {
            border: 1px solid transparent;
            transition: background .18s ease, border-color .18s ease, transform .18s ease;
        }
        body.societyadmin-mode .portal-nav button:hover {
            transform: translateX(2px);
            background: rgba(255, 255, 255, .08);
        }
        body.societyadmin-mode .portal-nav button.active {
            border-color: rgba(160, 179, 255, .18);
            background: linear-gradient(100deg, rgba(84, 111, 222, .38), rgba(84, 111, 222, .14));
            box-shadow: inset 3px 0 #94a7ff;
        }
        body.societyadmin-mode .portal-nav button:focus-visible,
        body.societyadmin-mode #portal-workspace button:focus-visible {
            outline: 3px solid rgba(104, 132, 255, .55);
            outline-offset: 2px;
        }
        body.societyadmin-mode .portal-topbar {
            background: rgba(255, 255, 255, .94);
            box-shadow: 0 4px 22px rgba(30, 51, 86, .025);
        }
        body.societyadmin-mode .portal-main-content {
            max-width: 1600px;
        }
        body.societyadmin-mode #portal-heading {
            position: relative;
            overflow: hidden;
            margin-bottom: 24px;
            padding: clamp(20px, 3vw, 32px);
            border: 1px solid #e0e8f5;
            border-radius: 22px;
            background: linear-gradient(115deg, #fff 0%, #f0f4ff 58%, #edf9f5 100%);
            box-shadow: 0 14px 38px rgba(30, 51, 86, .055);
        }
        body.societyadmin-mode #portal-heading::after {
            position: absolute;
            top: -78px;
            right: 6%;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(91, 120, 230, .14), rgba(91, 120, 230, 0));
            content: "";
            pointer-events: none;
        }
        body.societyadmin-mode #portal-heading > * {
            position: relative;
            z-index: 1;
        }
        body.societyadmin-mode #portal-heading .portal-eyebrow {
            display: inline-flex;
            align-items: center;
            padding: 7px 10px;
            border: 1px solid #dce5ff;
            border-radius: 999px;
            background: rgba(255, 255, 255, .78);
        }
        body.societyadmin-mode #portal-heading .portal-page-title {
            margin-top: 12px;
            font-size: clamp(28px, 3.2vw, 40px);
        }
        body.societyadmin-mode .portal-card {
            border-color: #e5ebf4;
            border-radius: 18px;
            box-shadow: 0 8px 24px rgba(30, 51, 86, .045);
        }
        body.societyadmin-mode #portal-workspace button.portal-card {
            transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
        }
        body.societyadmin-mode #portal-workspace button.portal-card:hover {
            transform: translateY(-2px);
            border-color: #cbd7f4;
            box-shadow: 0 14px 28px rgba(30, 51, 86, .09);
        }
        body.societyadmin-mode .society-dashboard-metric {
            position: relative;
            min-height: 142px;
            overflow: hidden;
            background: linear-gradient(145deg, #fff, #f8faff);
        }
        body.societyadmin-mode .society-dashboard-metric::after {
            position: absolute;
            top: -34px;
            right: -32px;
            width: 110px;
            height: 110px;
            border: 1px solid rgba(74, 102, 205, .08);
            border-radius: 50%;
            background: rgba(91, 120, 230, .045);
            content: "";
            pointer-events: none;
        }
        body.societyadmin-mode .society-dashboard-metric .portal-stat-value {
            position: relative;
            z-index: 1;
            margin: 4px 0 7px;
            color: #21345e;
            font-size: 34px;
        }
        body.societyadmin-mode .society-dashboard-metric .portal-stat-label {
            position: relative;
            z-index: 1;
            color: #384761;
            font-size: 13px;
        }
        body.societyadmin-mode #portal-workspace .society-dashboard { display: grid; gap: 22px; }
        body.societyadmin-mode #portal-workspace .society-dashboard-status-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
        body.societyadmin-mode #portal-workspace .society-dashboard-section-kicker { margin-right: auto; color: #718096; font-size: 10px; font-weight: 850; letter-spacing: .14em; }
        body.societyadmin-mode #portal-workspace .society-dashboard-live { display: inline-flex; align-items: center; gap: 8px; padding: 7px 11px; border: 1px solid #e6ebf2; border-radius: 999px; background: #fff; color: #68758a; font-size: 11px; font-weight: 700; }
        body.societyadmin-mode #portal-workspace .society-dashboard-live-dot { width: 8px; height: 8px; border-radius: 50%; background: #e7aa44; box-shadow: 0 0 0 3px rgba(231,170,68,.14); }
        body.societyadmin-mode #portal-workspace .society-dashboard-live.is-live { border-color: #cce8db; background: #f4fbf7; color: #317452; }
